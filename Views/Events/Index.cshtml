@model IEnumerable<EventEase.Models.Event>
@{ ViewData["Title"] = "Events"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="page-title">Events</h1>
    <a asp-action="Create" class="btn btn-success">Add Event</a>
</div>
<div class="table-card p-3">
<table class="table table-hover">
    <thead><tr><th>Event Name</th><th>Description</th><th>Image</th><th></th></tr></thead>
    <tbody>
@foreach (var item in Model) {
    <tr>
        <td>@item.EventName</td><td>@item.Description</td><td><img src="@item.ImageUrl" class="thumb" /></td>
        <td class="text-end"><a asp-action="Details" asp-route-id="@item.EventID" class="btn btn-outline-primary btn-sm">Details</a> <a asp-action="Edit" asp-route-id="@item.EventID" class="btn btn-outline-success btn-sm">Edit</a> <a asp-action="Delete" asp-route-id="@item.EventID" class="btn btn-outline-danger btn-sm">Delete</a></td>
    </tr>
}
    </tbody>
</table>
</div>
