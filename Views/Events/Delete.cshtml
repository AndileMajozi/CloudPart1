@model EventEase.Models.Event
@{ ViewData["Title"] = "Delete Event"; }
<h1 class="page-title">Delete Event</h1>
<div class="card p-4">
    <div class="alert alert-warning">Are you sure you want to delete this event? Events with active bookings will be blocked.</div>
    <h3>@Model.EventName</h3>
    <p>@Model.Description</p>
    <form asp-action="Delete">
        <input type="hidden" asp-for="EventID" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
