@model EventEase.Models.Venue
@{ ViewData["Title"] = "Delete Venue"; }
<h1 class="page-title">Delete Venue</h1>
<div class="card p-4">
    <div class="alert alert-warning">Are you sure you want to delete this venue? Venues with active bookings will be blocked.</div>
    <h3>@Model.Name</h3>
    <p>@Model.Location | Capacity: @Model.Capacity</p>
    <form asp-action="Delete">
        <input type="hidden" asp-for="VenueID" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
