@model IEnumerable<EventEase.Models.Venue>
@{ ViewData["Title"] = "Venues"; }
<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="page-title">Venues</h1>
    <a asp-action="Create" class="btn btn-success">Add Venue</a>
</div>
<div class="row g-4">
@foreach (var item in Model)
{
    <div class="col-md-4">
        <div class="card p-3 h-100">
            <img src="@item.ImageUrl" class="venue-img" alt="@item.Name" />
            <h4 class="mt-3">@item.Name</h4>
            <p class="mb-1"><strong>Location:</strong> @item.Location</p>
            <p><strong>Capacity:</strong> @item.Capacity</p>
            <div class="d-flex gap-2 flex-wrap">
                <a asp-action="Details" asp-route-id="@item.VenueID" class="btn btn-outline-primary btn-sm">Details</a>
                <a asp-action="Edit" asp-route-id="@item.VenueID" class="btn btn-outline-success btn-sm">Edit</a>
                <a asp-action="Delete" asp-route-id="@item.VenueID" class="btn btn-outline-danger btn-sm">Delete</a>
            </div>
        </div>
    </div>
}
</div>
