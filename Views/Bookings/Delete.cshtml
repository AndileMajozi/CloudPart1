@model EventEase.Models.Booking
@{ ViewData["Title"] = "Delete Booking"; }
<h1 class="page-title">Delete Booking</h1>
<div class="card p-4">
    <div class="alert alert-warning">Are you sure you want to delete this booking?</div>
    <p><strong>Booking ID:</strong> @Model.BookingID</p>
    <p><strong>Event:</strong> @Model.Event?.EventName</p>
    <p><strong>Venue:</strong> @Model.Venue?.Name</p>
    <form asp-action="Delete">
        <input type="hidden" asp-for="BookingID" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-action="Index" class="btn btn-secondary">Cancel</a>
    </form>
</div>
