@model EventEase.Models.Booking
@{ ViewData["Title"] = "Booking Details"; }
<h1 class="page-title">Booking Details</h1>
<div class="card p-4">
    <h3>@Model.BookingID</h3>
    <p><strong>Event:</strong> @Model.Event?.EventName</p>
    <p><strong>Venue:</strong> @Model.Venue?.Name</p>
    <p><strong>Location:</strong> @Model.Venue?.Location</p>
    <p><strong>Start:</strong> @Model.StartDate.ToString("yyyy-MM-dd HH:mm")</p>
    <p><strong>End:</strong> @Model.EndDate.ToString("yyyy-MM-dd HH:mm")</p>
    <a asp-action="Edit" asp-route-id="@Model.BookingID" class="btn btn-success">Edit</a>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</div>
